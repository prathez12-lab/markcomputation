pipeline {
agent any
tools {
maven &#39;Maven-3.9&#39;
jdk &#39;JDK-17&#39;
}
environment {
APP_NAME = &#39;currency-converter&#39;
GITHUB_URL = &#39;https://github.com/&lt;your-username&gt;/currency-converter.git&#39;
}
stages {
stage(&#39;Checkout&#39;) {
steps {

git branch: &#39;main&#39;,
url: &quot;${GITHUB_URL}&quot;
echo &quot;Source code checked out successfully&quot;
}
}
stage(&#39;Build&#39;) {
steps {
sh &#39;mvn clean compile&#39;
echo &quot;Build completed&quot;
}
}
stage(&#39;Test&#39;) {
steps {
sh &#39;mvn test&#39;
}
post {
always {
junit &#39;target/surefire-reports/*.xml&#39;
echo &quot;JUnit test results published&quot;
}
}
}
stage(&#39;Package&#39;) {
steps {
sh &#39;mvn package -DskipTests&#39;
archiveArtifacts artifacts: &#39;target/*.jar&#39;,
fingerprint: true
echo &quot;JAR archived: ${APP_NAME}&quot;
}
}
stage(&#39;Deploy&#39;) {
steps {
echo &quot;Deploying ${APP_NAME} to target environment...&quot;
sh &#39;java -jar target/*.jar || true&#39;
}
}
}
post {
success {
echo &quot;Pipeline SUCCESS - all tests passed!&quot;
}
failure {
echo &quot;Pipeline FAILED - check test reports above&quot;
}
}
}
