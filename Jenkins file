pipeline {
    agent any

    tools {
        maven 'Maven-3.9'
        jdk 'JDK-17'
    }

    environment {
        APP_NAME = 'currency-converter'
        GITHUB_URL = 'https://github.com/<your-username>/currency-converter.git'
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: "${GITHUB_URL}"

                echo "Source code checked out successfully"
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean compile'

                echo "Build completed"
            }
        }

        stage('Test') {
            steps {
                sh 'mvn test'
            }

            post {
                always {
                    junit 'target/surefire-reports/*.xml'

                    echo "JUnit test results published"
                }
            }
        }

        stage('Package') {
            steps {
                sh 'mvn package -DskipTests'

                archiveArtifacts artifacts: 'target/*.jar',
                                  fingerprint: true

                echo "JAR archived: ${APP_NAME}"
            }
        }

        stage('Deploy') {
            steps {
                echo "Deploying ${APP_NAME} to target environment..."

                sh 'java -jar target/*.jar || true'
            }
        }
    }

    post {
        success {
            echo "Pipeline SUCCESS - all tests passed!"
        }

        failure {
            echo "Pipeline FAILED - check test reports above"
        }
    }
}
